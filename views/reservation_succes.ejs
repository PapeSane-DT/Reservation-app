<%- include('partials/header', { title: 'Réservation validée !' }) %>

<div class="form-container">
    <div class="form-card" style="text-align: center; padding: 48px 32px;">
        <div style="width: 72px; height: 72px; background: var(--success-light); color: var(--success); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 32px; margin: 0 auto 24px; border: 2px solid rgba(16, 185, 129, 0.3);">
            <i class="fa-solid fa-check"></i>
        </div>

        <h1 style="font-family: var(--font-heading); font-size: 28px; font-weight: 800; color: var(--dark); margin-bottom: 10px;">
            Félicitations <%= reservation.prenom %> !
        </h1>
        <p style="color: var(--text-muted); font-size: 16px; margin-bottom: 28px;">
            Votre demande de réservation a été enregistrée avec succès.
        </p>

        <div style="background: var(--bg-page); border: 1.5px solid var(--border); border-radius: var(--radius-md); padding: 20px; text-align: left; margin-bottom: 28px;">
            <div style="font-weight: 700; color: var(--dark); font-size: 15px; margin-bottom: 12px; border-bottom: 1px solid var(--border); padding-bottom: 8px;">
                <i class="fa-solid fa-receipt"></i> Détails de votre réservation #<%= reservation.id %>
            </div>

            <div class="responsive-grid-2" style="font-size: 14px;">
                <div>
                    <span style="color: var(--text-muted); display: block; font-size: 12px;">Prestation</span>
                    <strong><%= service.nom %></strong>
                </div>
                <div>
                    <span style="color: var(--text-muted); display: block; font-size: 12px;">Coach</span>
                    <strong><%= service.coach_nom || 'Coach Certifié' %></strong>
                </div>
                <div>
                    <span style="color: var(--text-muted); display: block; font-size: 12px;">Date & Heure prévues</span>
                    <strong><%= reservation.date_reservation %> à <%= reservation.heure_reservation || '10:00' %></strong>
                </div>
                <div>
                    <span style="color: var(--text-muted); display: block; font-size: 12px;">Tarif</span>
                    <strong style="color: var(--primary);"><%= Number(service.prix).toLocaleString('fr-FR') %> FCFA</strong>
                </div>
                <div>
                    <span style="color: var(--text-muted); display: block; font-size: 12px;">Email de contact</span>
                    <span><%= reservation.email %></span>
                </div>
                <div>
                    <span style="color: var(--text-muted); display: block; font-size: 12px;">Téléphone</span>
                    <span><%= reservation.telephone %></span>
                </div>
            </div>
        </div>

        <% if (typeof waveBusiness !== 'undefined' && waveBusiness.paymentUrl) { %>
            <div style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: white; border-radius: var(--radius-md); padding: 22px 24px; margin-bottom: 24px; text-align: left; border: 1px solid rgba(255,255,255,0.08); box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                            <span style="background: #1da1f2; color: white; font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 9999px; text-transform: uppercase;">
                                <i class="fa-solid fa-wave-square"></i> Wave Sénégal
                            </span>
                            <span style="color: #94a3b8; font-size: 12.5px;">Marchand : <strong><%= waveBusiness.phone %></strong></span>
                        </div>
                        <h3 style="font-size: 18px; font-weight: 700; color: white; margin: 0 0 4px;">Réglez votre séance en 1 clic</h3>
                        <p style="color: #cbd5e1; font-size: 13px; margin: 0;">
                            Ouvre automatiquement votre application Wave avec le montant de <strong style="color: #38bdf8;"><%= Number(service.prix).toLocaleString('fr-FR') %> FCFA</strong> déjà prescrit.
                        </p>
                    </div>
                    <a href="<%= waveBusiness.paymentUrl %>" target="_blank" class="btn" style="background: #1da1f2; color: white; text-decoration: none; font-weight: 700; padding: 12px 22px; border-radius: 8px; display: inline-flex; align-items: center; gap: 10px; box-shadow: 0 4px 14px rgba(29, 161, 242, 0.4); white-space: nowrap;">
                        <i class="fa-solid fa-mobile-screen-button" style="font-size: 18px;"></i>
                        <span>Payer <%= Number(service.prix).toLocaleString('fr-FR') %> FCFA</span>
                    </a>
                </div>
            </div>
        <% } %>

        <div style="background: #ecfdf5; border: 1.5px solid #10b981; color: #065f46; border-radius: var(--radius-md); padding: 18px 20px; margin-bottom: 24px; text-align: left; display: flex; align-items: center; gap: 14px;">
            <i class="fa-solid fa-bell" style="font-size: 26px; color: #10b981; flex-shrink: 0;"></i>
            <div>
                <strong style="display: block; font-size: 15px; margin-bottom: 2px;">Notification interne active !</strong>
                <p style="font-size: 13px; color: #047857; margin: 0;">
                    Aucun email nécessaire : vous recevrez la confirmation de votre coach en direct sous forme de notification interne dans votre cloche 🔔 et sur votre compte.
                </p>
            </div>
        </div>

        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
            <a href="/client/compte" class="btn btn-primary btn-lg" style="background: #10b981; color: white;">
                <i class="fa-solid fa-bell"></i> Voir mon compte et mes notifications
            </a>
            <a href="/catalogue" class="btn btn-outline btn-lg">
                <i class="fa-solid fa-arrow-left"></i> Retour au catalogue
            </a>
        </div>
    </div>
</div>

<script>
    if ('<%= reservation.email %>') {
        localStorage.setItem('clientEmail', '<%= reservation.email %>');
        localStorage.setItem('clientNom', '<%= reservation.prenom %> <%= reservation.nom %>');
        if (typeof window.checkNotifications === 'function') {
            window.checkNotifications();
        }
    }
</script>

<%- include('partials/footer') %>

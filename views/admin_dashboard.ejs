<%- include('partials/header', { title: 'Console Administrateur' }) %>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<div class="container" style="max-width: 1400px; padding: 30px 20px 80px 20px;">
    
    <!-- EN-TÊTE PRINCIPAL DE LA CONSOLE ADMIN -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 20px; margin-bottom: 28px; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: white; padding: 28px 32px; border-radius: var(--radius-lg); box-shadow: 0 10px 25px rgba(15, 23, 42, 0.15);">
        <div>
            <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(56, 189, 248, 0.15); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 4px 12px; border-radius: 20px; margin-bottom: 12px;">
                <i class="fa-solid fa-shield-halved"></i> Supervision SaaS & Contrôle d'Accès (RBAC)
            </div>
            <h1 style="font-size: 28px; font-weight: 800; margin: 0 0 6px 0; color: white;">
                Console d'Administration Coach<span style="color: #38bdf8;">Flow</span>
            </h1>
            <p style="color: #94a3b8; font-size: 14.5px; margin: 0; max-width: 700px;">
                Pilotage centralisé en temps réel : utilisateurs, réservations multi-coachs, abonnements Wave Business (<strong style="color: #38bdf8;">5 000 FCFA/mois</strong>), réclamations et configuration.
            </p>
        </div>

        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <div style="background: rgba(255,255,255,0.08); padding: 8px 14px; border-radius: var(--radius-sm); border: 1px solid rgba(255,255,255,0.12); font-size: 13px;">
                <i class="fa-solid fa-user-gear" style="color: #38bdf8; margin-right: 6px;"></i>
                <strong><%= adminUser.nom_complet || adminUser.email %></strong>
                <span style="display: block; font-size: 11px; color: #94a3b8;">Super Admin</span>
            </div>
            <a href="/coach/dashboard" class="btn btn-secondary btn-sm" style="background: rgba(255,255,255,0.15); color: white; border-color: rgba(255,255,255,0.25);" title="Basculer vers mon dashboard coach personnel">
                <i class="fa-solid fa-chalkboard-user"></i> Vue Coach
            </a>
            <a href="/catalogue" target="_blank" class="btn btn-primary btn-sm" style="background: #0284c7; border-color: #0284c7;" title="Voir le catalogue public en ligne">
                <i class="fa-solid fa-arrow-up-right-from-square"></i> Catalogue
            </a>
        </div>
    </div>

    <!-- MESSAGES D'ALERTE ET NOTIFICATIONS D'ACTIONS -->
    <% if (query && query.success) { %>
        <div style="background: #ecfdf5; border-left: 4px solid #10b981; padding: 14px 20px; border-radius: var(--radius-sm); margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; box-shadow: var(--shadow-sm);">
            <div style="display: flex; align-items: center; gap: 10px; color: #065f46; font-size: 14px; font-weight: 600;">
                <i class="fa-solid fa-circle-check" style="color: #10b981; font-size: 18px;"></i>
                <% if (query.success === 'role_updated') { %>
                    Rôle de l'utilisateur modifié avec succès.
                <% } else if (query.success === 'sub_updated') { %>
                    Abonnement coach mis à jour avec succès (+30 jours appliqués).
                <% } else if (query.success === 'user_deleted') { %>
                    Utilisateur supprimé de la base de données avec succès.
                <% } else if (query.success === 'reservation_updated') { %>
                    Statut de la réservation mis à jour. Une notification interne automatique avec cloche 🔔 a été émise au client.
                <% } else if (query.success === 'tx_validated') { %>
                    Transaction Wave validée avec succès. L'abonnement du coach a été activé pour 30 jours.
                <% } else if (query.success === 'ticket_updated') { %>
                    Ticket de support mis à jour et réponse enregistrée.
                <% } else if (query.success === 'settings_saved') { %>
                    Paramètres de la plateforme sauvegardés avec succès.
                <% } else { %>
                    Opération administrateur réalisée avec succès.
                <% } %>
            </div>
            <a href="/admin/dashboard" style="color: #065f46; font-size: 16px; text-decoration: none;"><i class="fa-solid fa-xmark"></i></a>
        </div>
    <% } %>

    <% if (query && query.error) { %>
        <div style="background: #fef2f2; border-left: 4px solid #ef4444; padding: 14px 20px; border-radius: var(--radius-sm); margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; box-shadow: var(--shadow-sm);">
            <div style="display: flex; align-items: center; gap: 10px; color: #991b1b; font-size: 14px; font-weight: 600;">
                <i class="fa-solid fa-triangle-exclamation" style="color: #ef4444; font-size: 18px;"></i>
                <% if (query.error === 'cannot_delete_self') { %>
                    Action annulée : Vous ne pouvez pas supprimer votre propre compte administrateur actif.
                <% } else { %>
                    Une erreur est survenue lors de l'exécution de l'action.
                <% } %>
            </div>
            <a href="/admin/dashboard" style="color: #991b1b; font-size: 16px; text-decoration: none;"><i class="fa-solid fa-xmark"></i></a>
        </div>
    <% } %>

    <!-- BARRE D'ONGLETS DE NAVIGATION ADMIN -->
    <div class="admin-tabs-nav">
        <button type="button" class="admin-tab-btn active" data-tab="tab-overview">
            <i class="fa-solid fa-chart-pie"></i> Vue d'ensemble
        </button>
        <button type="button" class="admin-tab-btn" data-tab="tab-users">
            <i class="fa-solid fa-users"></i> Utilisateurs
            <span style="background: rgba(0,0,0,0.08); padding: 2px 7px; border-radius: 12px; font-size: 11.5px; margin-left: 4px;"><%= users.length %></span>
        </button>
        <button type="button" class="admin-tab-btn" data-tab="tab-reservations">
            <i class="fa-solid fa-calendar-check"></i> Réservations
            <span style="background: rgba(0,0,0,0.08); padding: 2px 7px; border-radius: 12px; font-size: 11.5px; margin-left: 4px;"><%= reservations.length %></span>
        </button>
        <button type="button" class="admin-tab-btn" data-tab="tab-subscriptions">
            <i class="fa-solid fa-crown"></i> Abonnements Coachs
            <span style="background: rgba(0,0,0,0.08); padding: 2px 7px; border-radius: 12px; font-size: 11.5px; margin-left: 4px;"><%= subscriptions.length %></span>
        </button>
        <button type="button" class="admin-tab-btn" data-tab="tab-payments">
            <i class="fa-solid fa-wallet"></i> Paiements & Wave
            <span style="background: rgba(0,0,0,0.08); padding: 2px 7px; border-radius: 12px; font-size: 11.5px; margin-left: 4px;"><%= transactions.length %></span>
        </button>
        <button type="button" class="admin-tab-btn" data-tab="tab-reclamations">
            <i class="fa-solid fa-headset"></i> Support & Réclamations
            <span style="background: rgba(0,0,0,0.08); padding: 2px 7px; border-radius: 12px; font-size: 11.5px; margin-left: 4px;"><%= reclamations.length %></span>
        </button>
        <button type="button" class="admin-tab-btn" data-tab="tab-settings">
            <i class="fa-solid fa-sliders"></i> Paramètres Plateforme
        </button>
    </div>

    <!-- ========================================================= -->
    <!-- ONGLET 1 : VUE D'ENSEMBLE (KPIS TEMPS RÉEL + CHARTS DYNAMIQUES) -->
    <!-- ========================================================= -->
    <div id="tab-overview" class="admin-tab-content active">
        
        <!-- GRILLE DE 8 CARTES KPI TEMPS RÉEL -->
        <div class="admin-kpi-grid">
            
            <!-- Clients -->
            <div class="admin-kpi-card">
                <div class="admin-kpi-header">
                    <span class="admin-kpi-label">Clients Uniques</span>
                    <div class="admin-kpi-icon" style="background: #e0f2fe; color: #0284c7;">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>
                <div class="admin-kpi-value"><%= stats.totalClients %></div>
                <div class="admin-kpi-footer" style="color: #0284c7;">
                    <i class="fa-solid fa-circle-check"></i> Actifs sur la plateforme
                </div>
            </div>

            <!-- Coachs -->
            <div class="admin-kpi-card">
                <div class="admin-kpi-header">
                    <span class="admin-kpi-label">Coachs Inscrits</span>
                    <div class="admin-kpi-icon" style="background: #eef2ff; color: #4361ee;">
                        <i class="fa-solid fa-user-tie"></i>
                    </div>
                </div>
                <div class="admin-kpi-value"><%= stats.totalCoaches %></div>
                <div class="admin-kpi-footer" style="color: #4361ee;">
                    <i class="fa-solid fa-certificate"></i> Experts & formateurs
                </div>
            </div>

            <!-- Abonnements Actifs -->
            <div class="admin-kpi-card">
                <div class="admin-kpi-header">
                    <span class="admin-kpi-label">Abonnements Actifs</span>
                    <div class="admin-kpi-icon" style="background: #fef3c7; color: #d97706;">
                        <i class="fa-solid fa-crown"></i>
                    </div>
                </div>
                <div class="admin-kpi-value"><%= stats.activeSubscriptions %></div>
                <div class="admin-kpi-footer" style="color: #d97706;">
                    <i class="fa-solid fa-bolt"></i> 5 000 FCFA / coach / mois
                </div>
            </div>

            <!-- Total Réservations -->
            <div class="admin-kpi-card">
                <div class="admin-kpi-header">
                    <span class="admin-kpi-label">Total Réservations</span>
                    <div class="admin-kpi-icon" style="background: #f3e8ff; color: #7e22ce;">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                </div>
                <div class="admin-kpi-value"><%= stats.totalReservations %></div>
                <div class="admin-kpi-footer" style="color: #7e22ce;">
                    <i class="fa-solid fa-layer-group"></i> Toutes séances cumulées
                </div>
            </div>

            <!-- Taux de Confirmation -->
            <div class="admin-kpi-card">
                <div class="admin-kpi-header">
                    <span class="admin-kpi-label">Taux Confirmation</span>
                    <div class="admin-kpi-icon" style="background: #dcfce7; color: #15803d;">
                        <i class="fa-solid fa-percent"></i>
                    </div>
                </div>
                <div class="admin-kpi-value"><%= stats.confirmationRate %>%</div>
                <div class="admin-kpi-footer" style="color: #15803d;">
                    <i class="fa-solid fa-thumbs-up"></i> <%= stats.confirmedReservations %> validées sur <%= stats.totalReservations %>
                </div>
            </div>

            <!-- Revenus Prestations -->
            <div class="admin-kpi-card">
                <div class="admin-kpi-header">
                    <span class="admin-kpi-label">Volume Prestations</span>
                    <div class="admin-kpi-icon" style="background: #ecfdf5; color: #059669;">
                        <i class="fa-solid fa-hand-holding-dollar"></i>
                    </div>
                </div>
                <div class="admin-kpi-value" style="font-size: 23px;">
                    <%= Number(stats.prestationRevenue).toLocaleString('fr-FR') %> <span style="font-size: 13px; font-weight: 600; color: #64748b;">FCFA</span>
                </div>
                <div class="admin-kpi-footer" style="color: #059669;">
                    <i class="fa-solid fa-check"></i> Séances confirmées
                </div>
            </div>

            <!-- Revenus Abonnements Wave -->
            <div class="admin-kpi-card">
                <div class="admin-kpi-header">
                    <span class="admin-kpi-label">Revenus Abonnements</span>
                    <div class="admin-kpi-icon" style="background: #e0f2fe; color: #0284c7;">
                        <i class="fa-solid fa-mobile-screen-button"></i>
                    </div>
                </div>
                <div class="admin-kpi-value" style="font-size: 23px;">
                    <%= Number(stats.subscriptionRevenue).toLocaleString('fr-FR') %> <span style="font-size: 13px; font-weight: 600; color: #64748b;">FCFA</span>
                </div>
                <div class="admin-kpi-footer" style="color: #0284c7;">
                    <i class="fa-solid fa-signal"></i> Encaissements Wave Business
                </div>
            </div>

            <!-- Chiffre d'Affaires Global -->
            <div class="admin-kpi-card" style="background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%); border-color: #cbd5e1;">
                <div class="admin-kpi-header">
                    <span class="admin-kpi-label" style="font-weight: 700; color: var(--primary);">Revenus Totaux</span>
                    <div class="admin-kpi-icon" style="background: var(--primary); color: white;">
                        <i class="fa-solid fa-vault"></i>
                    </div>
                </div>
                <div class="admin-kpi-value" style="font-size: 23px; color: var(--primary);">
                    <%= Number(stats.totalRevenue).toLocaleString('fr-FR') %> <span style="font-size: 13px; font-weight: 600; color: #64748b;">FCFA</span>
                </div>
                <div class="admin-kpi-footer" style="color: var(--primary); font-weight: 600;">
                    <i class="fa-solid fa-chart-line"></i> Flux global de la plateforme
                </div>
            </div>

        </div>

        <!-- GRAPHIQUES DYNAMIQUES CHART.JS (2 COLONNES) -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 20px; margin-bottom: 28px;">
            
            <!-- Graphique 1 : Évolution Mensuelle -->
            <div style="background: white; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 22px; box-shadow: var(--shadow-sm);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                    <div>
                        <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: var(--dark);">
                            <i class="fa-solid fa-chart-column" style="color: var(--primary); margin-right: 6px;"></i>
                            Évolution Mensuelle des Réservations & CA
                        </h3>
                        <p style="margin: 4px 0 0 0; font-size: 12.5px; color: var(--text-muted);">
                            Volume mensuel de séances et chiffre d'affaires des prestations
                        </p>
                    </div>
                    <span style="font-size: 11.5px; background: var(--bg); padding: 4px 10px; border-radius: 12px; font-weight: 600; color: var(--text-muted);">
                        Temps réel
                    </span>
                </div>
                <div style="position: relative; height: 280px; width: 100%;">
                    <canvas id="monthlyChart"></canvas>
                </div>
            </div>

            <!-- Graphique 2 : Répartition par Statut -->
            <div style="background: white; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 22px; box-shadow: var(--shadow-sm);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
                    <div>
                        <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: var(--dark);">
                            <i class="fa-solid fa-chart-pie" style="color: #10b981; margin-right: 6px;"></i>
                            Répartition des Réservations par Statut
                        </h3>
                        <p style="margin: 4px 0 0 0; font-size: 12.5px; color: var(--text-muted);">
                            Proportion des rendez-vous confirmés, en attente et annulés
                        </p>
                    </div>
                    <span style="font-size: 11.5px; background: var(--bg); padding: 4px 10px; border-radius: 12px; font-weight: 600; color: var(--text-muted);">
                        Total : <%= stats.totalReservations %>
                    </span>
                </div>
                <div style="position: relative; height: 280px; width: 100%; display: flex; justify-content: center; align-items: center;">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>

        </div>

        <!-- DERNIÈRES ACTIVITÉS & ACCÈS RAPIDES -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 20px;">
            
            <!-- Dernières réservations -->
            <div style="background: white; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 22px; box-shadow: var(--shadow-sm);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <h3 style="margin: 0; font-size: 15.5px; font-weight: 700; color: var(--dark);">
                        <i class="fa-solid fa-clock-rotate-left" style="color: var(--primary); margin-right: 6px;"></i>
                        Dernières Réservations Enregistrées
                    </h3>
                    <button type="button" onclick="switchAdminTab('tab-reservations')" style="background: none; border: none; color: var(--primary); font-size: 12px; font-weight: 600; cursor: pointer;">
                        Tout voir &rarr;
                    </button>
                </div>
                
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <% if (reservations.length === 0) { %>
                        <div style="text-align: center; color: var(--text-muted); padding: 20px 0; font-size: 13.5px;">
                            Aucune réservation enregistrée pour l'instant.
                        </div>
                    <% } else { %>
                        <% reservations.slice(0, 5).forEach(function(r) { %>
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: #f8fafc; border-radius: var(--radius-sm); border: 1px solid #f1f5f9;">
                                <div>
                                    <div style="font-weight: 700; font-size: 13.5px; color: var(--dark);">
                                        <%= (r.prenom || r.nom) ? (r.prenom + ' ' + (r.nom || '')) : (r.email || 'Client invité') %>
                                    </div>
                                    <div style="font-size: 12px; color: var(--text-muted);">
                                        <%= r.service_nom %> • Coach : <strong><%= r.coach_nom || 'Non assigné' %></strong>
                                    </div>
                                </div>
                                <div style="text-align: right;">
                                    <span class="badge <%= r.statut === 'confirme' ? 'badge-success' : (r.statut === 'en_attente' ? 'badge-warning' : 'badge-danger') %>">
                                        <%= r.statut === 'confirme' ? 'Confirmé' : (r.statut === 'en_attente' ? 'En attente' : 'Annulé') %>
                                    </span>
                                    <div style="font-size: 11px; color: var(--text-light); margin-top: 3px;">
                                        <%= Number(r.prix || 0).toLocaleString('fr-FR') %> FCFA
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>

            <!-- Dernières Transactions Wave & Support -->
            <div style="background: white; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 22px; box-shadow: var(--shadow-sm);">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <h3 style="margin: 0; font-size: 15.5px; font-weight: 700; color: var(--dark);">
                        <i class="fa-solid fa-money-check-dollar" style="color: #0284c7; margin-right: 6px;"></i>
                        Dernières Transactions Wave Business
                    </h3>
                    <button type="button" onclick="switchAdminTab('tab-payments')" style="background: none; border: none; color: var(--primary); font-size: 12px; font-weight: 600; cursor: pointer;">
                        Historique complet &rarr;
                    </button>
                </div>

                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <% if (transactions.length === 0) { %>
                        <div style="text-align: center; color: var(--text-muted); padding: 20px 0; font-size: 13.5px;">
                            Aucune transaction Wave enregistrée pour l'instant.
                        </div>
                    <% } else { %>
                        <% transactions.slice(0, 5).forEach(function(tx) { %>
                            <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: #f8fafc; border-radius: var(--radius-sm); border: 1px solid #f1f5f9;">
                                <div>
                                    <div style="font-weight: 700; font-size: 13.5px; color: var(--dark);">
                                        <%= tx.coach_nom || ('Coach #' + tx.coach_id) %>
                                    </div>
                                    <div style="font-size: 11.5px; color: var(--text-muted); font-family: monospace;">
                                        <%= tx.client_reference %>
                                    </div>
                                </div>
                                <div style="text-align: right;">
                                    <span class="badge <%= tx.status === 'completed' ? 'badge-success' : (tx.status === 'pending' ? 'badge-warning' : 'badge-danger') %>">
                                        <%= tx.status %>
                                    </span>
                                    <div style="font-size: 11.5px; font-weight: 700; color: var(--dark); margin-top: 3px;">
                                        <%= Number(tx.amount || 5000).toLocaleString('fr-FR') %> FCFA
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>

        </div>

    </div>

    <!-- ========================================================= -->
    <!-- ONGLET 2 : GESTION DES UTILISATEURS (RECHERCHE + FILTRES + ACTIONS) -->
    <!-- ========================================================= -->
    <div id="tab-users" class="admin-tab-content">
        
        <!-- BARRE DE RECHERCHE ET FILTRES -->
        <div class="admin-filter-bar">
            <div class="admin-search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="users-search-input" placeholder="Rechercher par nom, email, téléphone ou spécialité...">
            </div>
            <div class="admin-filter-controls">
                <select id="users-role-filter" class="admin-select">
                    <option value="">Tous les rôles</option>
                    <option value="admin">Administrateurs</option>
                    <option value="coach">Coachs</option>
                    <option value="client">Clients</option>
                </select>
                <select id="users-sub-filter" class="admin-select">
                    <option value="">Tous les abonnements</option>
                    <option value="active">Actif</option>
                    <option value="inactive">Inactif / Expiré</option>
                </select>
                <span id="users-count-badge" style="font-size: 13px; font-weight: 600; color: var(--text-muted); padding-left: 6px;">
                    <%= users.length %> utilisateur(s)
                </span>
            </div>
        </div>

        <!-- TABLEAU DES UTILISATEURS -->
        <div style="background: white; border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm);">
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 13.5px;" id="users-table">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 2px solid var(--border); color: #475569; text-align: left;">
                            <th style="padding: 14px 18px; font-weight: 700;">ID</th>
                            <th style="padding: 14px 18px; font-weight: 700;">Utilisateur</th>
                            <th style="padding: 14px 18px; font-weight: 700;">Téléphone</th>
                            <th style="padding: 14px 18px; font-weight: 700;">Rôle (RBAC)</th>
                            <th style="padding: 14px 18px; font-weight: 700;">Spécialité</th>
                            <th style="padding: 14px 18px; font-weight: 700;">Abonnement</th>
                            <th style="padding: 14px 18px; font-weight: 700;">Inscription</th>
                            <th style="padding: 14px 18px; font-weight: 700; text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="users-table-body">
                        <% users.forEach(function(u) { %>
                            <tr class="user-row" 
                                data-role="<%= u.role %>" 
                                data-sub="<%= u.subscription_status %>" 
                                data-search="<%= (u.nom_complet || '') + ' ' + (u.email || '') + ' ' + (u.telephone || '') + ' ' + (u.expertise || '') %>" 
                                style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 14px 18px; font-weight: 600; color: var(--text-muted); font-size: 12.5px;">#<%= u.id %></td>
                                <td style="padding: 14px 18px;">
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <div style="width: 36px; height: 36px; border-radius: 50%; background: <%= u.role === 'admin' ? '#0f172a' : (u.role === 'coach' ? '#4361ee' : '#64748b') %>; color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px;">
                                            <%= (u.nom_complet ? u.nom_complet.charAt(0).toUpperCase() : u.email.charAt(0).toUpperCase()) %>
                                        </div>
                                        <div>
                                            <div style="font-weight: 700; color: var(--dark);"><%= u.nom_complet || 'Sans nom' %></div>
                                            <div style="font-size: 12px; color: var(--text-muted);"><%= u.email %></div>
                                        </div>
                                    </div>
                                </td>
                                <td style="padding: 14px 18px; color: var(--text-main);"><%= u.telephone || '—' %></td>
                                <td style="padding: 14px 18px;">
                                    <form action="/admin/users/<%= u.id %>/role" method="POST" style="display: inline-block;">
                                        <select name="role" onchange="this.form.submit()" class="admin-select" style="padding: 4px 8px; font-size: 12px; border-radius: 6px; font-weight: 600; background: <%= u.role === 'admin' ? '#f1f5f9' : (u.role === 'coach' ? '#eff6ff' : '#f8fafc') %>;">
                                            <option value="coach" <%= u.role === 'coach' ? 'selected' : '' %>>Coach</option>
                                            <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Administrateur</option>
                                            <option value="client" <%= u.role === 'client' ? 'selected' : '' %>>Client</option>
                                        </select>
                                    </form>
                                </td>
                                <td style="padding: 14px 18px;">
                                    <span style="font-size: 12px; background: #f1f5f9; padding: 3px 8px; border-radius: 4px; font-weight: 500;">
                                        <%= u.expertise || 'Général' %>
                                    </span>
                                </td>
                                <td style="padding: 14px 18px;">
                                    <% if (u.subscription_status === 'active') { %>
                                        <span class="badge badge-success"><i class="fa-solid fa-check"></i> Actif</span>
                                        <% if (u.subscription_expires_at) { %>
                                            <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                                                Exp : <%= new Date(u.subscription_expires_at).toLocaleDateString('fr-FR') %>
                                            </div>
                                        <% } %>
                                    <% } else { %>
                                        <span class="badge badge-danger"><i class="fa-solid fa-xmark"></i> Inactif</span>
                                    <% } %>
                                </td>
                                <td style="padding: 14px 18px; font-size: 12px; color: var(--text-muted);">
                                    <%= u.created_at ? new Date(u.created_at).toLocaleDateString('fr-FR') : '—' %>
                                </td>
                                <td style="padding: 14px 18px; text-align: center;">
                                    <div style="display: flex; gap: 6px; justify-content: center; align-items: center;">
                                        <!-- Bouton +30 Jours Abonnement -->
                                        <form action="/admin/users/<%= u.id %>/abonnement" method="POST" style="display: inline;">
                                            <input type="hidden" name="action" value="extend30">
                                            <button type="submit" class="btn btn-outline btn-sm" style="padding: 4px 8px; font-size: 11px;" title="Activer ou ajouter 30 jours d'abonnement coach">
                                                <i class="fa-solid fa-calendar-plus" style="color: #10b981;"></i> +30j
                                            </button>
                                        </form>

                                        <!-- Bouton Supprimer l'utilisateur -->
                                        <% if (u.id !== adminUser.id) { %>
                                            <form action="/admin/users/<%= u.id %>/supprimer" method="POST" style="display: inline;" onsubmit="return confirm('Confirmez-vous la suppression définitive de cet utilisateur ?');">
                                                <button type="submit" class="btn btn-outline btn-sm" style="padding: 4px 8px; font-size: 11px; color: #ef4444; border-color: #fee2e2;" title="Supprimer cet utilisateur">
                                                    <i class="fa-regular fa-trash-can"></i>
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <span style="font-size: 11px; color: var(--text-light); font-style: italic;">(Moi)</span>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION UTILISATEURS -->
            <div class="admin-pagination" id="users-pagination">
                <div id="users-page-info">Affichage des résultats</div>
                <div class="admin-page-btns" id="users-page-btns"></div>
            </div>
        </div>

    </div>

    <!-- ========================================================= -->
    <!-- ONGLET 3 : TOUTES LES RÉSERVATIONS (FILTRE PAR COACH & STATUT) -->
    <!-- ========================================================= -->
    <div id="tab-reservations" class="admin-tab-content">
        
        <div class="admin-filter-bar">
            <div class="admin-search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="res-search-input" placeholder="Rechercher par client, email, coach ou prestation...">
            </div>
            <div class="admin-filter-controls">
                <select id="res-status-filter" class="admin-select">
                    <option value="">Tous les statuts</option>
                    <option value="confirme">Confirmé ✅</option>
                    <option value="en_attente">En attente ⏳</option>
                    <option value="annule">Annulé ❌</option>
                </select>
                <select id="res-coach-filter" class="admin-select">
                    <option value="">Tous les coachs</option>
                    <% 
                        const distinctCoaches = [...new Set(reservations.map(r => r.coach_nom).filter(Boolean))];
                        distinctCoaches.forEach(function(cName) { 
                    %>
                        <option value="<%= cName %>"><%= cName %></option>
                    <% }); %>
                </select>
                <span id="res-count-badge" style="font-size: 13px; font-weight: 600; color: var(--text-muted); padding-left: 6px;">
                    <%= reservations.length %> réservation(s)
                </span>
            </div>
        </div>

        <div style="background: white; border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm);">
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 13.5px;" id="res-table">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 2px solid var(--border); color: #475569; text-align: left;">
                            <th style="padding: 14px 18px; font-weight: 700;">ID</th>
                            <th style="padding: 14px 18px; font-weight: 700;">Client</th>
                            <th style="padding: 14px 18px; font-weight: 700;">Prestation & Tarif</th>
                            <th style="padding: 14px 18px; font-weight: 700;">Coach Assigné</th>
                            <th style="padding: 14px 18px; font-weight: 700;">Date & Heure</th>
                            <th style="padding: 14px 18px; font-weight: 700;">Statut</th>
                            <th style="padding: 14px 18px; font-weight: 700; text-align: center;">Mettre à jour le Statut</th>
                        </tr>
                    </thead>
                    <tbody id="res-table-body">
                        <% reservations.forEach(function(r) { %>
                            <tr class="res-row" 
                                data-status="<%= r.statut %>" 
                                data-coach="<%= r.coach_nom || '' %>" 
                                data-search="<%= (r.prenom || '') + ' ' + (r.nom || '') + ' ' + (r.email || '') + ' ' + (r.telephone || '') + ' ' + (r.service_nom || '') + ' ' + (r.coach_nom || '') %>" 
                                style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 14px 18px; font-weight: 600; color: var(--text-muted); font-size: 12.5px;">#<%= r.id %></td>
                                <td style="padding: 14px 18px;">
                                    <div style="font-weight: 700; color: var(--dark);">
                                        <%= (r.prenom || r.nom) ? (r.prenom + ' ' + (r.nom || '')) : (r.email || 'Client invité') %>
                                    </div>
                                    <div style="font-size: 12px; color: var(--text-muted);"><%= r.email || 'Pas d\'email' %></div>
                                    <div style="font-size: 11.5px; color: var(--text-light);"><%= r.telephone || '' %></div>
                                </td>
                                <td style="padding: 14px 18px;">
                                    <div style="font-weight: 600; color: var(--dark);"><%= r.service_nom %></div>
                                    <div style="font-size: 12px; color: #10b981; font-weight: 700;">
                                        <%= Number(r.prix || 0).toLocaleString('fr-FR') %> FCFA
                                        <span style="font-weight: 400; color: var(--text-muted); margin-left: 4px;">(<%= r.duree_minutes || 60 %> min)</span>
                                    </div>
                                </td>
                                <td style="padding: 14px 18px;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div style="width: 28px; height: 28px; border-radius: 50%; background: #eef2ff; color: #4361ee; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: 700;">
                                            <%= (r.coach_nom ? r.coach_nom.charAt(0).toUpperCase() : 'C') %>
                                        </div>
                                        <span style="font-weight: 600; color: var(--dark); font-size: 13px;"><%= r.coach_nom || 'Non spécifié' %></span>
                                    </div>
                                </td>
                                <td style="padding: 14px 18px;">
                                    <div style="font-weight: 600; color: var(--dark);">
                                        <i class="fa-regular fa-calendar" style="color: var(--primary); margin-right: 4px;"></i>
                                        <%= r.date_reservation ? new Date(r.date_reservation).toLocaleDateString('fr-FR') : 'Date non définie' %>
                                    </div>
                                    <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">
                                        <i class="fa-regular fa-clock" style="margin-right: 4px;"></i> <%= r.heure_reservation || '10:00' %>
                                    </div>
                                </td>
                                <td style="padding: 14px 18px;">
                                    <span class="badge <%= r.statut === 'confirme' ? 'badge-success' : (r.statut === 'en_attente' ? 'badge-warning' : 'badge-danger') %>">
                                        <%= r.statut === 'confirme' ? 'Confirmé' : (r.statut === 'en_attente' ? 'En attente' : 'Annulé') %>
                                    </span>
                                </td>
                                <td style="padding: 14px 18px; text-align: center;">
                                    <!-- FORMULAIRE RAPIDE DE MISE À JOUR DU STATUT -->
                                    <form action="/admin/reservations/<%= r.id %>/statut" method="POST" style="display: inline-flex; align-items: center; gap: 6px;">
                                        <select name="statut" class="admin-select" style="padding: 5px 8px; font-size: 12px; border-radius: 6px;">
                                            <option value="confirme" <%= r.statut === 'confirme' ? 'selected' : '' %>>✅ Confirmer</option>
                                            <option value="en_attente" <%= r.statut === 'en_attente' ? 'selected' : '' %>>⏳ En attente</option>
                                            <option value="annule" <%= r.statut === 'annule' ? 'selected' : '' %>>❌ Annuler</option>
                                        </select>
                                        <button type="submit" class="btn btn-secondary btn-sm" style="padding: 5px 10px; font-size: 11px;" title="Sauvegarder le nouveau statut et notifier le client">
                                            Appliquer
                                        </button>
                                    </form>
                                    <div style="font-size: 10.5px; color: var(--text-light); margin-top: 3px;">
                                        🔔 Notification interne auto
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION RÉSERVATIONS -->
            <div class="admin-pagination" id="res-pagination">
                <div id="res-page-info">Affichage des réservations</div>
                <div class="admin-page-btns" id="res-page-btns"></div>
            </div>
        </div>

    </div>

    <!-- ========================================================= -->
    <!-- ONGLET 4 : ABONNEMENTS COACHS (5 000 FCFA / MOIS) -->
    <!-- ========================================================= -->
    <div id="tab-subscriptions" class="admin-tab-content">
        
        <!-- BANNIÈRE TARIFAIRE -->
        <div style="background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border: 1px solid #bfdbfe; border-radius: var(--radius-md); padding: 18px 24px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
            <div>
                <h3 style="margin: 0 0 4px 0; font-size: 16px; color: #1e40af; font-weight: 800;">

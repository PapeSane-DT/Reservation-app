<!-- SCRIPT JS CLIENT-SIDE : GESTION DES ONGLETS, FILTRES, RECHERCHE, PAGINATION & CHARTS -->
<script>
    // 1. GESTION DES ONGLETS
    function switchAdminTab(targetTabId) {
        document.querySelectorAll('.admin-tab-btn').forEach(btn => {
            btn.classList.toggle('active', btn.getAttribute('data-tab') === targetTabId);
        });
        document.querySelectorAll('.admin-tab-content').forEach(content => {
            content.classList.toggle('active', content.id === targetTabId);
        });
        // Mettre à jour l'URL sans rechargement
        if (history.pushState) {
            const newUrl = window.location.protocol + "//" + window.location.host + window.location.pathname + '?tab=' + targetTabId.replace('tab-', '');
            window.history.pushState({ path: newUrl }, '', newUrl);
        }
    }

    document.querySelectorAll('.admin-tab-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const target = this.getAttribute('data-tab');
            switchAdminTab(target);
        });
    });

    // Activer l'onglet demandé dans l'URL s'il existe
    window.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const reqTab = urlParams.get('tab');
        if (reqTab && document.getElementById('tab-' + reqTab)) {
            switchAdminTab('tab-' + reqTab);
        }
    });

    // 2. MOTEUR UNIVERSEL DE RECHERCHE, FILTRAGE ET PAGINATION
    function setupTableEngine(config) {
        const {
            rowClass,
            searchInputId,
            filterSelects,
            paginationId,
            pageInfoId,
            pageBtnsId,
            countBadgeId,
            itemsPerPage = 10
        } = config;

        let currentPage = 1;
        const allRows = Array.from(document.querySelectorAll('.' + rowClass));
        const searchInput = document.getElementById(searchInputId);
        const pageInfo = document.getElementById(pageInfoId);
        const pageBtns = document.getElementById(pageBtnsId);
        const countBadge = document.getElementById(countBadgeId);

        function filterAndPaginate() {
            const query = searchInput ? searchInput.value.toLowerCase().trim() : '';

            // Filtrage multi-critères
            const filteredRows = allRows.filter(row => {
                const searchData = (row.getAttribute('data-search') || '').toLowerCase();
                const matchesSearch = !query || searchData.includes(query);

                let matchesSelects = true;
                if (filterSelects && filterSelects.length > 0) {
                    for (const f of filterSelects) {
                        const selectEl = document.getElementById(f.selectId);
                        if (selectEl && selectEl.value) {
                            const rowVal = row.getAttribute(f.dataAttr) || '';
                            if (rowVal.toLowerCase() !== selectEl.value.toLowerCase()) {
                                matchesSelects = false;
                                break;
                            }
                        }
                    }
                }

                return matchesSearch && matchesSelects;
            });

            // Mise à jour du badge de comptage
            if (countBadge) {
                countBadge.textContent = filteredRows.length + ' élément(s)';
            }

            // Calcul pagination
            const totalItems = filteredRows.length;
            const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = startIndex + itemsPerPage;

            // Masquer toutes les lignes puis afficher uniquement celles de la page courante
            allRows.forEach(r => r.style.display = 'none');
            filteredRows.forEach((r, idx) => {
                if (idx >= startIndex && idx < endIndex) {
                    r.style.display = '';
                }
            });

            // Mise à jour texte d'info pagination
            if (pageInfo) {
                if (totalItems === 0) {
                    pageInfo.textContent = 'Aucun résultat trouvé.';
                } else {
                    pageInfo.textContent = `Affichage ${startIndex + 1} à ${Math.min(endIndex, totalItems)} sur ${totalItems}`;
                }
            }

            // Génération des boutons de pagination
            if (pageBtns) {
                pageBtns.innerHTML = '';
                if (totalPages > 1) {
                    // Bouton précédent
                    const prevBtn = document.createElement('button');
                    prevBtn.className = 'admin-page-btn';
                    prevBtn.innerHTML = '<i class="fa-solid fa-chevron-left"></i>';
                    prevBtn.disabled = currentPage === 1;
                    prevBtn.onclick = () => { currentPage--; filterAndPaginate(); };
                    pageBtns.appendChild(prevBtn);

                    // Numéros de page
                    for (let p = 1; p <= totalPages; p++) {
                        if (p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) {
                            const pBtn = document.createElement('button');
                            pBtn.className = 'admin-page-btn' + (p === currentPage ? ' active' : '');
                            pBtn.textContent = p;
                            pBtn.onclick = () => { currentPage = p; filterAndPaginate(); };
                            pageBtns.appendChild(pBtn);
                        } else if (p === currentPage - 2 || p === currentPage + 2) {
                            const dots = document.createElement('span');
                            dots.textContent = '...';
                            dots.style.padding = '0 4px';
                            dots.style.color = 'var(--text-light)';
                            pageBtns.appendChild(dots);
                        }
                    }

                    // Bouton suivant
                    const nextBtn = document.createElement('button');
                    nextBtn.className = 'admin-page-btn';
                    nextBtn.innerHTML = '<i class="fa-solid fa-chevron-right"></i>';
                    nextBtn.disabled = currentPage === totalPages;
                    nextBtn.onclick = () => { currentPage++; filterAndPaginate(); };
                    pageBtns.appendChild(nextBtn);
                }
            }
        }

        // Écouteurs de recherche et filtres
        if (searchInput) {
            searchInput.addEventListener('input', () => { currentPage = 1; filterAndPaginate(); });
        }
        if (filterSelects) {
            filterSelects.forEach(f => {
                const el = document.getElementById(f.selectId);
                if (el) el.addEventListener('change', () => { currentPage = 1; filterAndPaginate(); });
            });
        }

        // Initialisation immédiate
        filterAndPaginate();
    }

    // Initialisation des 5 tables interactives
    setupTableEngine({
        rowClass: 'user-row',
        searchInputId: 'users-search-input',
        filterSelects: [
            { selectId: 'users-role-filter', dataAttr: 'data-role' },
            { selectId: 'users-sub-filter', dataAttr: 'data-sub' }
        ],
        paginationId: 'users-pagination',
        pageInfoId: 'users-page-info',
        pageBtnsId: 'users-page-btns',
        countBadgeId: 'users-count-badge',
        itemsPerPage: 10
    });

    setupTableEngine({
        rowClass: 'res-row',
        searchInputId: 'res-search-input',
        filterSelects: [
            { selectId: 'res-status-filter', dataAttr: 'data-status' },
            { selectId: 'res-coach-filter', dataAttr: 'data-coach' }
        ],
        paginationId: 'res-pagination',
        pageInfoId: 'res-page-info',
        pageBtnsId: 'res-page-btns',
        countBadgeId: 'res-count-badge',
        itemsPerPage: 10
    });

    setupTableEngine({
        rowClass: 'sub-row',
        searchInputId: 'sub-search-input',
        filterSelects: [
            { selectId: 'sub-status-filter', dataAttr: 'data-status' }
        ],
        paginationId: 'sub-pagination',
        pageInfoId: 'sub-page-info',
        pageBtnsId: 'sub-page-btns',
        countBadgeId: 'sub-count-badge',
        itemsPerPage: 10
    });

    setupTableEngine({
        rowClass: 'tx-row',
        searchInputId: 'tx-search-input',
        filterSelects: [
            { selectId: 'tx-status-filter', dataAttr: 'data-status' }
        ],
        paginationId: 'tx-pagination',
        pageInfoId: 'tx-page-info',
        pageBtnsId: 'tx-page-btns',
        countBadgeId: 'tx-count-badge',
        itemsPerPage: 10
    });

    setupTableEngine({
        rowClass: 'rec-row',
        searchInputId: 'rec-search-input',
        filterSelects: [
            { selectId: 'rec-status-filter', dataAttr: 'data-status' }
        ],
        paginationId: 'rec-pagination',
        pageInfoId: 'rec-page-info',
        pageBtnsId: 'rec-page-btns',
        countBadgeId: 'rec-count-badge',
        itemsPerPage: 10
    });

    // 3. INITIALISATION DES GRAPHIQUES CHART.JS
    const monthlyDataRaw = <%- JSON.stringify(monthlyTrends || []) %>;
    const statsDataRaw = <%- JSON.stringify(stats || {}) %>;

    // A. Graphique combiné Réservations & CA Mensuel
    const monthlyLabels = monthlyDataRaw.length > 0 
        ? monthlyDataRaw.map(m => m.mois) 
        : ['2026-07', '2026-08', '2026-09', '2026-10', '2026-11'];
    const monthlyCounts = monthlyDataRaw.length > 0 
        ? monthlyDataRaw.map(m => Number(m.count_reservations || 0)) 
        : [4, 0, 0, 4, 1];
    const monthlyRevs = monthlyDataRaw.length > 0 
        ? monthlyDataRaw.map(m => Number(m.ca_reservations || 0)) 
        : [10000, 0, 0, 30000, 10000];

    const ctxMonthly = document.getElementById('monthlyChart');
    if (ctxMonthly) {
        new Chart(ctxMonthly, {
            type: 'bar',
            data: {
                labels: monthlyLabels,
                datasets: [
                    {
                        type: 'bar',
                        label: 'Chiffre d\'Affaires (FCFA)',
                        data: monthlyRevs,
                        backgroundColor: 'rgba(67, 97, 238, 0.75)',
                        borderColor: '#4361ee',
                        borderWidth: 1.5,
                        borderRadius: 6,
                        yAxisID: 'yRev'
                    },
                    {
                        type: 'line',
                        label: 'Nombre de Réservations',
                        data: monthlyCounts,
                        borderColor: '#10b981',
                        backgroundColor: '#10b981',
                        borderWidth: 3,
                        pointBackgroundColor: '#10b981',
                        pointRadius: 5,
                        tension: 0.3,
                        yAxisID: 'yCount'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                scales: {
                    yRev: {
                        type: 'linear',
                        position: 'left',
                        title: { display: true, text: 'Revenus (FCFA)', font: { size: 11, weight: '600' } },
                        ticks: {
                            callback: value => Number(value).toLocaleString('fr-FR') + ' F'
                        },
                        grid: { color: 'rgba(0,0,0,0.05)' }
                    },
                    yCount: {
                        type: 'linear',
                        position: 'right',
                        title: { display: true, text: 'Nb Séances', font: { size: 11, weight: '600' } },
                        ticks: { stepSize: 1 },
                        grid: { display: false }
                    },
                    x: {
                        grid: { display: false }
                    }
                },
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { font: { family: 'Plus Jakarta Sans', size: 12, weight: '600' } }
                    }
                }
            }
        });
    }

    // B. Graphique Doughnut Répartition des Statuts
    const ctxStatus = document.getElementById('statusChart');
    if (ctxStatus) {
        new Chart(ctxStatus, {
            type: 'doughnut',
            data: {
                labels: ['Confirmées ✅', 'En attente ⏳', 'Annulées ❌'],
                datasets: [{
                    data: [
                        statsDataRaw.confirmedReservations || 0,
                        statsDataRaw.pendingReservations || 0,
                        statsDataRaw.cancelledReservations || 0
                    ],
                    backgroundColor: [
                        '#10b981', // Confirmé vert
                        '#f59e0b', // En attente orange
                        '#ef4444'  // Annulé rouge
                    ],
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 18,
                            font: { family: 'Plus Jakarta Sans', size: 12, weight: '600' }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const total = (statsDataRaw.confirmedReservations || 0) + (statsDataRaw.pendingReservations || 0) + (statsDataRaw.cancelledReservations || 0);
                                const val = context.raw || 0;
                                const pct = total > 0 ? Math.round((val / total) * 100) : 0;
                                return ` ${context.label}: ${val} (${pct}%)`;
                            }
                        }
                    }
                },
                cutout: '68%'
            }
        });
    }
</script>

<%- include('partials/footer') %>

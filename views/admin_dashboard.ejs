                                </td>
                                <td style="padding: 14px 18px; font-size: 12px; color: var(--text-muted);">
                                    <%= tx.created_at ? new Date(tx.created_at).toLocaleString('fr-FR') : '—' %>
                                </td>
                                <td style="padding: 14px 18px; text-align: center;">
                                    <% if (tx.status !== 'completed') { %>
                                        <form action="/admin/transactions/<%= tx.id %>/valider" method="POST" style="display: inline;" onsubmit="return confirm('Valider manuellement cette transaction et créditer 30 jours au coach ?');">
                                            <button type="submit" class="btn btn-secondary btn-sm" style="padding: 4px 10px; font-size: 11.5px;">
                                                <i class="fa-solid fa-check-double"></i> Valider (+30j)
                                            </button>
                                        </form>
                                    <% } else { %>
                                        <span style="color: #10b981; font-size: 12px; font-weight: 600;">
                                            <i class="fa-solid fa-circle-check"></i> Encaissé
                                        </span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION TRANSACTIONS -->
            <div class="admin-pagination" id="tx-pagination">
                <div id="tx-page-info">Affichage des paiements</div>
                <div class="admin-page-btns" id="tx-page-btns"></div>
            </div>
        </div>

    </div>


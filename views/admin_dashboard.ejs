                                <td style="padding: 14px 18px; font-weight: 600; color: var(--text-muted); font-size: 12.5px;">#<%= rec.id %></td>
                                <td style="padding: 14px 18px;">
                                    <div style="font-weight: 700; color: var(--dark);"><%= rec.nom %></div>
                                    <div style="font-size: 12px; color: var(--text-muted);"><%= rec.email %></div>
                                </td>
                                <td style="padding: 14px 18px;">
                                    <div style="font-weight: 700; color: var(--dark); margin-bottom: 4px;"><%= rec.sujet %></div>
                                    <div style="font-size: 12.5px; color: var(--text-main); background: #f8fafc; padding: 8px 12px; border-radius: 6px; border: 1px solid #f1f5f9; line-height: 1.4;">
                                        <%= rec.message %>
                                    </div>
                                    <% if (rec.reponse) { %>
                                        <div style="font-size: 11.5px; color: #0284c7; background: #e0f2fe; padding: 6px 10px; border-radius: 6px; margin-top: 6px;">
                                            <strong>Réponse admin :</strong> <%= rec.reponse %>
                                        </div>
                                    <% } %>
                                </td>
                                <td style="padding: 14px 18px; font-size: 12px; color: var(--text-muted); white-space: nowrap;">
                                    <%= rec.created_at ? new Date(rec.created_at).toLocaleDateString('fr-FR') : '—' %>
                                </td>
                                <td style="padding: 14px 18px;">
                                    <span class="badge <%= rec.statut === 'resolu' ? 'badge-success' : (rec.statut === 'en_cours' ? 'badge-warning' : (rec.statut === 'ferme' ? 'badge-secondary' : 'badge-danger')) %>">
                                        <%= rec.statut %>
                                    </span>
                                </td>
                                <td style="padding: 14px 18px;">
                                    <form action="/admin/reclamations/<%= rec.id %>/statut" method="POST" style="display: flex; flex-direction: column; gap: 8px;">
                                        <div style="display: flex; gap: 6px;">
                                            <select name="statut" class="admin-select" style="flex: 1; padding: 5px 8px; font-size: 12px;">
                                                <option value="ouvert" <%= rec.statut === 'ouvert' ? 'selected' : '' %>>Ouvert</option>
                                                <option value="en_cours" <%= rec.statut === 'en_cours' ? 'selected' : '' %>>En cours</option>
                                                <option value="resolu" <%= rec.statut === 'resolu' ? 'selected' : '' %>>Résolu</option>
                                                <option value="ferme" <%= rec.statut === 'ferme' ? 'selected' : '' %>>Fermé</option>
                                            </select>
                                            <button type="submit" class="btn btn-primary btn-sm" style="padding: 5px 12px; font-size: 11.5px;">
                                                Enregistrer
                                            </button>
                                        </div>
                                        <input type="text" name="reponse" placeholder="Note de traitement ou réponse..." value="<%= rec.reponse || '' %>" style="width: 100%; padding: 6px 10px; font-size: 12px; border: 1px solid var(--border); border-radius: 6px; outline: none;">
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION RÉCLAMATIONS -->
            <div class="admin-pagination" id="rec-pagination">
                <div id="rec-page-info">Affichage des réclamations</div>
                <div class="admin-page-btns" id="rec-page-btns"></div>
            </div>
        </div>

    </div>

    <!-- ========================================================= -->
    <!-- ONGLET 7 : PARAMÈTRES DU SYSTÈME ET DU SAAS -->
    <!-- ========================================================= -->

            </div>
            <div class="admin-filter-controls">
                <select id="sub-status-filter" class="admin-select">
                    <option value="">Tous les états</option>
                    <option value="active">Actif</option>
                    <option value="inactive">Expiré / Inactif</option>
                </select>
                <span id="sub-count-badge" style="font-size: 13px; font-weight: 600; color: var(--text-muted); padding-left: 6px;">
                    <%= subscriptions.length %> coach(s)
                </span>
            </div>
        </div>

        <div style="background: white; border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm);">
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 13.5px;" id="sub-table">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 2px solid var(--border); color: #475569; text-align: left;">
                            <th style="padding: 14px 18px; font-weight: 700;">Coach</th>
                            <th style="padding: 14px 18px; font-weight: 700;">Spécialité & Contact</th>
                            <th style="padding: 14px 18px; font-weight: 700;">Statut Abonnement</th>
                            <th style="padding: 14px 18px; font-weight: 700;">Date d'Expiration</th>
                            <th style="padding: 14px 18px; font-weight: 700;">Jours Restants</th>
                            <th style="padding: 14px 18px; font-weight: 700; text-align: center;">Gestion Rapide</th>
                        </tr>
                    </thead>
                    <tbody id="sub-table-body">
                        <% subscriptions.forEach(function(s) { %>
                            <tr class="sub-row" 
                                data-status="<%= s.subscription_status %>" 
                                data-search="<%= (s.nom_complet || '') + ' ' + (s.email || '') + ' ' + (s.telephone || '') + ' ' + (s.expertise || '') %>" 
                                style="border-bottom: 1px solid var(--border);">
                                <td style="padding: 14px 18px;">
                                    <div style="font-weight: 700; color: var(--dark);"><%= s.nom_complet || 'Coach sans nom' %></div>
                                    <div style="font-size: 12px; color: var(--text-muted);"><%= s.email %></div>
                                </td>
                                <td style="padding: 14px 18px;">
                                    <div style="font-weight: 600; color: var(--dark); font-size: 13px;"><%= s.expertise || 'Non précisé' %></div>
                                    <div style="font-size: 12px; color: var(--text-muted);"><%= s.telephone || '—' %></div>
                                </td>
                                <td style="padding: 14px 18px;">
                                    <% if (s.subscription_status === 'active') { %>
                                        <span class="badge badge-success"><i class="fa-solid fa-check"></i> Actif (5 000 FCFA)</span>
                                    <% } else { %>
                                        <span class="badge badge-danger"><i class="fa-solid fa-xmark"></i> Inactif</span>
                                    <% } %>
                                </td>
                                <td style="padding: 14px 18px; font-weight: 600; color: var(--dark);">
                                    <%= s.subscription_expires_at ? new Date(s.subscription_expires_at).toLocaleDateString('fr-FR') : 'Non renseignée' %>
                                </td>
                                <td style="padding: 14px 18px;">
                                    <% if (s.subscription_status === 'active' && s.jours_restants !== null) { %>
                                        <span style="font-weight: 700; color: <%= s.jours_restants > 7 ? '#10b981' : '#f59e0b' %>;">
                                            <%= s.jours_restants %> jour(s) restant(s)
                                        </span>
                                    <% } else { %>
                                        <span style="color: var(--text-muted); font-size: 12.5px;">Expiré ou inactif</span>
                                    <% } %>
                                </td>
                                <td style="padding: 14px 18px; text-align: center;">
                                    <div style="display: flex; gap: 8px; justify-content: center; align-items: center;">
                                        <!-- Prolonger +30 jours -->
                                        <form action="/admin/users/<%= s.id %>/abonnement" method="POST" style="display: inline;">
                                            <input type="hidden" name="action" value="extend30">
                                            <button type="submit" class="btn btn-primary btn-sm" style="padding: 5px 12px; font-size: 12px;">
                                                <i class="fa-solid fa-circle-plus"></i> +30 Jours
                                            </button>
                                        </form>

                                        <!-- Désactiver si actif -->
                                        <% if (s.subscription_status === 'active') { %>
                                            <form action="/admin/users/<%= s.id %>/abonnement" method="POST" style="display: inline;" onsubmit="return confirm('Suspendre l\'abonnement de ce coach ?');">
                                                <input type="hidden" name="action" value="deactivate">
                                                <button type="submit" class="btn btn-outline btn-sm" style="padding: 5px 10px; font-size: 12px; color: #ef4444; border-color: #fee2e2;">
                                                    Suspendre
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION ABONNEMENTS -->
            <div class="admin-pagination" id="sub-pagination">
                <div id="sub-page-info">Affichage des abonnements</div>
                <div class="admin-page-btns" id="sub-page-btns"></div>
            </div>
        </div>

    </div>


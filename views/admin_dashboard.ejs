            <div style="display: flex; gap: 10px; align-items: center;">
                <span style="font-size: 13px; font-weight: 700; color: #1e40af; background: white; padding: 6px 14px; border-radius: 20px; border: 1px solid #bfdbfe;">
                    Actifs : <%= stats.activeSubscriptions %> / <%= subscriptions.length %>
                </span>
            </div>
        </div>

        <div class="admin-filter-bar">
            <div class="admin-search-box">

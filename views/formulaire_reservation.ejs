<%- include('partials/header', { title: 'Réservation — ' + service.nom }) %>

<div class="form-container">
    <div style="margin-bottom: 20px;">
        <a href="/catalogue" style="color: var(--text-muted); text-decoration: none; font-size: 14px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
            <i class="fa-solid fa-arrow-left"></i> Retour au catalogue
        </a>
    </div>

    <!-- Récapitulatif de la séance -->
    <div class="booking-recap">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(255,255,255,0.15); padding: 4px 10px; border-radius: 9999px;">
                <%= service.domaine || 'Coaching' %>
            </span>
            <span style="font-size: 13px; color: #cbd5e1;">
                <i class="fa-regular fa-clock"></i> <%= service.duree_minutes %> minutes
            </span>
        </div>

        <h3><%= service.nom %></h3>
        <p><%= service.description %></p>

        <div style="font-size: 13.5px; color: #94a3b8; margin-bottom: 12px;">
            Coach : <strong style="color: white;"><%= service.coach_nom || 'Coach Certifié' %></strong> (<%= service.coach_expertise || 'Expert' %>)
        </div>

        <div class="booking-recap-meta">
            <span style="font-size: 13px; color: #cbd5e1;">Montant de la prestation :</span>
            <span class="price"><%= Number(service.prix).toLocaleString('fr-FR') %> FCFA</span>
        </div>
    </div>

    <!-- Formulaire avec STRICTEMENT les 4 informations obligatoires du client -->
    <div class="form-card">
        <div class="form-header">
            <h2>Confirmez votre réservation</h2>
            <p>Remplissez vos 4 coordonnées pour valider votre place. Aucun mot de passe requis.</p>
        </div>

        <% if (typeof erreur !== 'undefined' && erreur) { %>
            <div class="alert-error">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span><%= erreur %></span>
            </div>
        <% } %>

        <form action="/reserver/confirmer" method="POST">
            <input type="hidden" name="service_id" value="<%= service.id %>">

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                <!-- 1. PRÉNOM (Obligatoire) -->
                <div class="form-group">
                    <label for="prenom">1. Prénom <span class="required">*</span></label>
                    <input type="text" id="prenom" name="prenom" placeholder="Ex: Moussa" required autofocus>
                </div>

                <!-- 2. NOM (Obligatoire) -->
                <div class="form-group">
                    <label for="nom">2. Nom <span class="required">*</span></label>
                    <input type="text" id="nom" name="nom" placeholder="Ex: Diallo" required>
                </div>
            </div>

            <!-- 3. ADRESSE E-MAIL (Obligatoire) -->
            <div class="form-group">
                <label for="email">3. Adresse e-mail <span class="required">*</span></label>
                <input type="email" id="email" name="email" placeholder="Ex: moussa.diallo@email.com" required>
                <div class="form-help">Vous y recevrez la confirmation et le lien de votre séance.</div>
            </div>

            <!-- 4. NUMÉRO DE TÉLÉPHONE (Obligatoire) -->
            <div class="form-group">
                <label for="telephone">4. Numéro de téléphone <span class="required">*</span></label>
                <input type="tel" id="telephone" name="telephone" placeholder="Ex: +221 77 123 45 67" required>
                <div class="form-help">Utilisé pour le rappel SMS ou WhatsApp avant la séance.</div>
            </div>

            <!-- Choix du créneau (Date & Heure) -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
                <div class="form-group">
                    <label for="date_reservation">Date souhaitée <span class="required">*</span></label>
                    <input type="date" id="date_reservation" name="date_reservation" required min="<%= new Date().toISOString().split('T')[0] %>">
                </div>
                <div class="form-group">
                    <label for="heure_reservation">Heure souhaitée <span class="required">*</span></label>
                    <input type="time" id="heure_reservation" name="heure_reservation" value="10:00" required>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg" style="width: 100%; margin-top: 10px;">
                <i class="fa-solid fa-check"></i> Valider ma réservation
            </button>
        </form>
    </div>
</div>

<%- include('partials/footer') %>
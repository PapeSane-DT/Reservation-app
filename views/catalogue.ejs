<%- include('partials/header', { title: 'Catalogue des Coachings & Formations' }) %>

<header class="hero">
    <div class="hero-content">
        <div class="hero-tag">
            <i class="fa-solid fa-sparkles"></i> Réservation instantanée sans compte
        </div>
        <h1>Trouvez votre coach et développez vos compétences</h1>
        <p>Réservez des séances individuelles ou des formations avec des experts certifiés en Business, Fitness, Langues et plus encore.</p>
        
        <div class="filter-bar">
            <!-- Barre de recherche -->
            <form action="/catalogue" method="GET" class="search-box">
                <input type="text" name="search" placeholder="Rechercher un coaching, une formation ou un nom de coach..." value="<%= searchQuery || '' %>">
                <% if (selectedDomaine && selectedDomaine !== 'Tous') { %>
                    <input type="hidden" name="domaine" value="<%= selectedDomaine %>">
                <% } %>
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-magnifying-glass"></i> <span class="search-btn-text">Rechercher</span>
                </button>
            </form>

            <!-- Filtres par domaine d'expertise -->
            <div class="category-pills">
                <a href="/catalogue<%= searchQuery ? '?search=' + encodeURIComponent(searchQuery) : '' %>" 
                   class="pill <%= (!selectedDomaine || selectedDomaine === 'Tous') ? 'active' : '' %>">
                    <i class="fa-solid fa-border-all"></i> Tous les domaines
                </a>

                <% domaines.forEach(function(d) { %>
                    <a href="/catalogue?domaine=<%= encodeURIComponent(d) %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>" 
                       class="pill <%= selectedDomaine === d ? 'active' : '' %>">
                        <% if (d.toLowerCase().includes('business')) { %>
                            <i class="fa-solid fa-briefcase"></i>
                        <% } else if (d.toLowerCase().includes('fitness') || d.toLowerCase().includes('sport')) { %>
                            <i class="fa-solid fa-dumbbell"></i>
                        <% } else if (d.toLowerCase().includes('langue')) { %>
                            <i class="fa-solid fa-language"></i>
                        <% } else if (d.toLowerCase().includes('tech') || d.toLowerCase().includes('code')) { %>
                            <i class="fa-solid fa-laptop-code"></i>
                        <% } else { %>
                            <i class="fa-solid fa-star"></i>
                        <% } %>
                        <%= d %>
                    </a>
                <% }); %>
            </div>
        </div>
    </div>
</header>

<main class="catalog-section">
    <% if (services.length === 0) { %>
        <div style="text-align: center; padding: 60px 20px; background: white; border-radius: var(--radius-lg); border: 1px solid var(--border);">
            <div style="font-size: 48px; color: var(--text-light); margin-bottom: 16px;"><i class="fa-regular fa-folder-open"></i></div>
            <h3 style="font-family: var(--font-heading); font-size: 22px; margin-bottom: 8px;">Aucune formation trouvée</h3>
            <p style="color: var(--text-muted); margin-bottom: 24px;">Aucune offre ne correspond à vos critères de recherche actuellement.</p>
            <a href="/catalogue" class="btn btn-primary">Réinitialiser les filtres</a>
        </div>
    <% } else { %>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <div style="font-weight: 700; color: var(--text-muted); font-size: 14px;">
                Affichage de <span style="color: var(--dark);"><%= services.length %></span> prestation<%= services.length > 1 ? 's' : '' %> disponible<%= services.length > 1 ? 's' : '' %>
            </div>
        </div>

        <div class="grid-cards">
            <% services.forEach(function(service) { %>
                <div class="card">
                    <div class="card-header">
                        <% 
                            let domClass = 'domain-default';
                            let domLower = (service.domaine || '').toLowerCase();
                            if (domLower.includes('business')) domClass = 'domain-business';
                            else if (domLower.includes('fitness') || domLower.includes('sport')) domClass = 'domain-fitness';
                            else if (domLower.includes('langue')) domClass = 'domain-langues';
                            else if (domLower.includes('tech') || domLower.includes('code')) domClass = 'domain-tech';
                        %>
                        <span class="badge-domain <%= domClass %>">
                            <%= service.domaine || 'Général' %>
                        </span>
                        <span class="card-duration">
                            <i class="fa-regular fa-clock"></i> <%= service.duree_minutes %> min
                        </span>
                    </div>

                    <div class="card-body">
                        <h2 class="card-title"><%= service.nom %></h2>
                        <p class="card-desc"><%= service.description %></p>

                        <div class="card-coach">
                            <div class="coach-avatar">
                                <%= (service.coach_nom || 'Coach').charAt(0).toUpperCase() %>
                            </div>
                            <div class="coach-details">
                                <div class="coach-name"><%= service.coach_nom || 'Coach Certifié' %></div>
                                <div class="coach-exp">Spécialiste <%= service.coach_expertise || service.domaine || 'Expert' %></div>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer">
                        <div class="card-price">
                            <span class="price-label">Tarif de la séance</span>
                            <span class="price-val"><%= Number(service.prix).toLocaleString('fr-FR') %> FCFA</span>
                        </div>
                        <a href="/reserver/<%= service.id %>" class="btn btn-primary">
                            Réserver <i class="fa-solid fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>